{
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/displays",
    "tray",
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "disk",
    "network",
    "battery"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "tray": {
    "spacing": 6
  },
  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 Muted",
    "on-click": "/usr/bin/pavucontrol",
    "on-click-right": "~/.config/waybar/select-audio-output.py"
  },
  "backlight": {
    "format": "Brightness {percent}%",
    "scroll-step": 5,
    "min-brightness": 1
  },
  "network": {
    "format-wifi": "Wi-Fi ↓{bandwidthDownBytes:>10} ↑{bandwidthUpBytes:>10}",
    "format-ethernet": "LAN   ↓{bandwidthDownBytes:>10} ↑{bandwidthUpBytes:>10}",
    "format-disconnected": "Offline",
    "on-click": "nm-connection-editor",
    "interval": 2,
    "tooltip-format-wifi": "{essid} · Signal {signalStrength}%\n{ifname}: {ipaddr}\nNed: {bandwidthDownBytes}\nUpp: {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}\nNed: {bandwidthDownBytes}\nUpp: {bandwidthUpBytes}",
    "min-length": 32,
    "max-length": 32,
    "align": 0
  },
  "battery": {
    "format": "Battery {capacity}%"
  },
  "custom/displays": {
    "format": "🖥",
    "tooltip": false,
    "on-click": "/usr/bin/wdisplays",
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/displays-menu.xml",
    "menu-actions": {
      "open": "/usr/bin/wdisplays",
      "save": "~/.local/bin/save-kanshi-profile"
    }
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage:2}%",
    "tooltip-format": "Processor: {usage}%\nBelastning: {load}",
    "on-click": "foot -e htop"
  },
  "memory": {
    "interval": 2,
    "format": "RAM {percentage}%",
    "tooltip-format": "Minne: {used:.1f} / {total:.1f} GiB\nTillgängligt: {avail:.1f} GiB",
    "on-click": "foot -e htop"
  },
  "disk": {
    "interval": 30,
    "path": "/",
    "format": "Disk {percentage_used}%",
    "tooltip-format": "Använt: {used} / {total}\nLedigt: {free}\nFilsystem: {path}"
  }
}
