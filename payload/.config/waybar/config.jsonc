{
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/displays",
    "tray",
    "pulseaudio",
    "backlight",
    "network",
    "battery"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "tray": {
    "spacing": 6
  },
  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 Muted",
    "on-click": "/usr/bin/pavucontrol",
    "on-click-right": "@HOME@/.config/waybar/select-audio-output.py"
  },
  "backlight": {
    "format": "Brightness {percent}%",
    "scroll-step": 5,
    "min-brightness": 1
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "Battery {capacity}%"
  },
  "custom/displays": {
    "format": "🖥",
    "tooltip": false,
    "on-click": "/usr/bin/wdisplays",
    "menu": "on-click-right",
    "menu-file": "@HOME@/.config/waybar/displays-menu.xml",
    "menu-actions": {
      "open": "/usr/bin/wdisplays",
      "save": "@HOME@/.local/bin/save-kanshi-profile"
    }
  }
}
